{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DNT Note",
  "version": "0.1.0",
  "identifier": "com.dungnt.dntnote",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DNT Note",
        "width": 1280,
        "height": 800,
        "minWidth": 860,
        "minHeight": 560,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
