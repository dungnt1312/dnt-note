{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for DNT Note main and helper windows",
  "windows": ["main", "quickcapture", "print-*"],
  "permissions": [
    "core:default",
    "store:default",
    "opener:default",
    "dialog:default",
    "deep-link:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://**" },
        { "url": "http://localhost:**" },
        { "url": "http://127.0.0.1:**" }
      ]
    },
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister"
  ]
}
